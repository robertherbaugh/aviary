{
  "name": "aviary-platform",
  "private": true,
  "version": "0.1.1",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev --parallel",
    "lint": "bunx turbo run lint",
    "test": "bunx turbo run test",
    "typecheck": "bunx turbo run typecheck",
    "format": "bunx prettier --write .",
    "sync-version": "bun run scripts/sync-versions.mjs",
    "check-version": "bun run scripts/sync-versions.mjs --check",
    "db:generate": "bun --env-file=.env --filter=@aviary/db run prisma:generate",
    "db:migrate:dev": "bun --env-file=.env --filter=@aviary/db run prisma:migrate:dev",
    "db:migrate:deploy": "bun --env-file=.env --filter=@aviary/db run prisma:migrate:deploy",
    "db:seed": "bun --env-file=.env --filter=@aviary/db run seed"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "nodemailer": "^8.0.4",
    "prom-client": "^15.1.3"
  }
}
