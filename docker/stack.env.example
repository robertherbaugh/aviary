# === Traefik / Portainer stack variables ===
# Domain that Traefik will route to this stack
AVIARY_DOMAIN=aviary.example.com
# Traefik cert resolver name (default: letsencrypt)
TRAEFIK_CERTRESOLVER=letsencrypt
# External Docker network Traefik is attached to (default: traefik)
TRAEFIK_NETWORK=traefik

# === Database ===
POSTGRES_PASSWORD=change-me

# === Application variables ===
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/aviary
MIGRATE_ON_STARTUP=true
API_PORT=4000
# SECURITY: generate with: openssl rand -hex 32
JWT_SECRET=change-me
# SECURITY: must be a unique 32-char hex key — generate with: openssl rand -hex 16
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# SECURITY: set to false and remove LOCAL_BOOTSTRAP_ADMIN_PASSWORD after first login
LOCAL_BOOTSTRAP_ADMIN=true
LOCAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LOCAL_BOOTSTRAP_ADMIN_PASSWORD=change-me
TOTP_ISSUER=Aviary
PGBOSS_SCHEMA=pgboss
PGBOSS_QUEUE=playbook-jobs
# SECURITY: generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=internal-token
WORKER_API_BASE_URL=http://api:4000
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=5
